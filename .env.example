DEEPINFRA_API_KEY=your_deepinfra_api_key_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_VERIFY_TOKEN=chatbot_verify_2024
FB_APP_SECRET=your_facebook_app_secret
HOST=0.0.0.0
PORT=8290
DEEPINFRA_MODEL=google/gemma-3-12b-it

# Per-agent model routing (optional — all default to DEEPINFRA_MODEL)
# Use a small/fast model for intent classification, larger for closing
MODEL_INTENT=google/gemma-3-12b-it
MODEL_CLOSING=google/gemma-3-12b-it
MODEL_GENERAL=google/gemma-3-12b-it

ADMIN_TOKEN=change_me_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
DB_PATH=data/chatbot.db

# Redis — leave empty to use in-memory fallback (no Redis needed for dev)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

JWT_SECRET=change_me_to_a_random_64_char_string_here
CORS_ORIGINS=http://localhost:8290,https://yourdomain.com
SESSION_MAX_ENTRIES=5000
